{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "extends": ["./packages/biome-config/biome.base.json"],
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/node_modules",
      "!**/.turbo",
      "!pnpm-lock.yaml",
      "!dot/raw",
      "!dot/final"
    ]
  },
  "linter": {
    "includes": ["**", "!dot/**"]
  }
}
